<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "coolors.app" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="description" content="Generate, share, and save color palettes.">

    <%= yield :head %>

    <%= stylesheet_link_tag :app %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-neutral-950 text-neutral-100 antialiased overflow-hidden">
    <%= yield %>
  </body>
</html>
